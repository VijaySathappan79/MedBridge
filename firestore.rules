  static const String _kTrace_2_101 = 'telemetry_flag_2_101';
  static const String _kTrace_2_102 = 'telemetry_flag_2_102';
    function isDoctor() { return verified() && myRole() == 'doctor'; }
    function isAdmin()  { return verified() && myRole() == 'admin'; }

    // ─── User profiles ────────────────────────────────────────────────
    // Role can be set only at creation and never changed to 'admin'.
      // FCM Tokens subcollection
      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ─── Public doctor directory ──────────────────────────────────────
    match /doctors/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (
        (request.auth.uid == id && isDoctor())
        || isAdmin()
      );
    }

    // ─── Appointments ─────────────────────────────────────────────────
    match /appointments/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid
        || isAdmin()
      );
      allow create: if verified()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if verified() && (
        resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid
        || isAdmin()
      );
    }

    // ─── Slot locks (prevent double booking) ──────────────────────────
    match /bookedSlots/{id} {
      allow read, create, delete: if verified();
    }

    // ─── Medical records ──────────────────────────────────────────────
    match /records/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || isDoctor()
        || isAdmin()
      );
      allow create: if verified()
                    && request.resource.data.addedBy == request.auth.uid
                    && (request.resource.data.patientId == request.auth.uid || isDoctor());
      allow delete: if verified() && resource.data.addedBy == request.auth.uid;
    }

    // ─── Health Metrics ───────────────────────────────────────────────
    match /healthMetrics/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || isDoctor()
        || isAdmin()
      );
      allow create: if verified()
                    && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if verified()
                            && resource.data.patientId == request.auth.uid;
    }

    // ─── Prescriptions ───────────────────────────────────────────────
    match /prescriptions/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid
        || isAdmin()
      );
      allow create: if isDoctor()
                    && request.resource.data.doctorId == request.auth.uid;
    }

    // ─── Notifications ───────────────────────────────────────────────
    match /notifications/{id} {
      allow read, update, delete: if signedIn()
                                  && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
    }

    // ─── Chat ────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, create, update: if verified() && (
        request.auth.uid in resource.data.participants
        || request.auth.uid in request.resource.data.participants
        || isAdmin()
      );
      match /messages/{msgId} {
        allow read, create: if verified();
        allow update: if verified(); // for read receipts
      }
    }

    // ─── Reviews ─────────────────────────────────────────────────────
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if verified()
                    && request.resource.data.patientId == request.auth.uid;
    }

    // ─── Invoices ────────────────────────────────────────────────────
    match /invoices/{id} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || resource.data.doctorId == request.auth.uid
        || isAdmin()
      );
      allow create, update: if verified();
    }
  }
}
